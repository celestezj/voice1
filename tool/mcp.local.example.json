{
  "mcpServers": {
    "search": {
      "command": "C:/path/to/.venv-search/Scripts/python.exe",
      "args": ["-m", "search_mcp"],
      "env": {}
    },
    "weather": {
      "url": "http://127.0.0.1:8080/mcp"
    },
    "author_info": {
      "timeout": 60,
      "type": "stdio",
      "command": "python",
      "args": ["./tool/mcp_tools/author.py"]
    },
    "lunar": {
      "timeout": 60,
      "type": "stdio",
      "command": "python",
      "args": ["./tool/mcp_tools/lunar.py"]
    }
  }
}
